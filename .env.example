# .env.example – copy to .env and fill in your values
# .env is gitignored and must NEVER be committed to the repository.

# ── Backend selection ─────────────────────────────────────────────────────────
# 'tibber' (default, works today) or 'carconnectivity' (VW-direct, currently
# blocked by VW -- see README.md warning). See README.md#choosing-a-backend.
MCP_BACKEND=tibber

# ── Tibber Data API credentials (default backend) ─────────────────────────────
# Register an OAuth2 client at https://data-api.tibber.com/clients/manage/ --
# see experiment/tibber-integration/README.md for the exact scopes/redirect URI.
TIBBER_CLIENT_ID=your-tibber-client-id-here
TIBBER_CLIENT_SECRET=your-tibber-client-secret-here

# Bootstrap only, first run of this container: run
#   python -m weconnect_mcp.cli.tibber_login_cli
# LOCALLY first (Tibber's login is interactive and can't run in a headless
# container), then paste that run's token file contents here verbatim. This
# seeds the tibber-tokens volume once; every token refresh afterward rewrites
# the volume directly, so it's safe to leave this set (it's never read again
# once the volume has a file). Leave empty/unset until you've done that.
TIBBER_TOKEN_JSON=

# ── VW WeConnect credentials (carconnectivity backend, currently blocked) ─────
VW_USERNAME=your_email@example.com
VW_PASSWORD=your_password_here
VW_SPIN=1234

# ── MCP Server API key ────────────────────────────────────────────────────────
# Clients (ChatGPT, Claude, etc.) must send this as:
#   Authorization: Bearer <MCP_API_KEY>
# Generate a strong random key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=change-me-to-a-strong-random-secret
