# Version control
# .git/ is intentionally NOT excluded: setuptools_scm (see pyproject.toml's
# [tool.setuptools_scm]) needs it in the builder stage to derive the package
# version from the nearest git tag, the same way a local `pip install -e .`
# does. It never reaches the final runtime image -- Dockerfile's runtime
# stage only COPYs the builder's compiled /install output and src/, not
# .git itself.
.github/

# Python artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/

# Virtual environment
.venv/
venv/

# Credentials – NEVER copy into image
src/config.json
src/tokenstore.json
/tmp/tokenstore*
logs/

# Development / editor
.vscode/
.DS_Store
*.swp
*.swo

# Tests (not needed in production image)
tests/

# Docs / examples
examples/
tmp/
