# Tibber Data API experiment — copy to .env and fill in.
# .env is gitignored and must NEVER be committed.
#
# Create an OAuth2 client at: https://data-api.tibber.com/clients/manage/
#   - Register the redirect URI below (default: http://localhost:8515/callback)
#   - Grant scopes: data-api-user-read, data-api-homes-read, data-api-vehicles-read
#   - The client secret is shown only once at creation time — copy it now.

TIBBER_CLIENT_ID=your-client-id-here
TIBBER_CLIENT_SECRET=your-client-secret-here

# Must exactly match a redirect URI registered on the client above.
TIBBER_REDIRECT_URI=http://localhost:8515/callback

# Optional: where to cache OAuth tokens (default: ./.tibber_tokens.json, gitignored).
# TIBBER_TOKEN_PATH=./.tibber_tokens.json
